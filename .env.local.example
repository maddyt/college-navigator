# Copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# College Scorecard API key (free at https://api.data.gov/signup/)
# Used only by the one-time data-import script on Day 2 — not exposed to the browser.
COLLEGE_SCORECARD_API_KEY=your-api-data-gov-key
